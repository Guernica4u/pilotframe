// Pilot movement tuning, read by pf-movement through the game (pf-game).
//
// [set]    = the pilot settings files on the PC discs (scripts/players/mp/pilot_*.set).
// [engine] = the game's own engine defaults, read from the owner's client.dll
//            (docs/movement/r1-engine-values.md has each one's name and description).
// [mp]     = multiplayer server values: Respawn's listenserver.cfg (if_mp column)
//            as shipped with R1Delta, confirmed live in the running game.
// [live]   = read from the running game's player object (local, read-only).
// [wiki]   = the Titanfall fandom wiki (community source, medium confidence).
// [guess]  = placeholder, still to be measured.
//
// Units: game units (~1 inch), seconds, degrees.
// The game reloads this file when you save it, no restart needed.
(
    // Body
    capsule_radius: 16.0,      // [set] hull ±16
    capsule_height: 72.0,      // [set] stand hull_max z
    eye_height: 60.0,          // [set] stand viewheight
    crouch_height: 47.0,       // [set] crouch hull_max z
    crouch_eye_height: 38.0,   // [set] crouch viewheight

    // Ground
    walk_speed: 180.6,         // [set] speed
    sprint_speed: 269.85,      // [set] sprintspeed
    crouch_speed: 89.25,       // [set] crouch speed
    acceleration: 2500.0,      // [engine] stand acceleration
    deceleration: 1500.0,      // [engine] stand deceleration is unset (-1): the game uses 0.6 × acceleration

    // Air
    air_speed: 60.0,           // [engine] airSpeed
    air_acceleration: 500.0,   // [engine] airAcceleration
    air_extra_acceleration: 0.2, // [engine] player_extraairaccelleration
    jump_turn_time_min: 0.2,   // [engine] jump_keyboardgraceperiodmin
    jump_turn_time_max: 0.5,   // [engine] jump_keyboardgraceperiodmax
    jump_turn_strength: 0.7,   // [engine] jump_keyboardgrace_strength
    jump_turn_max: 0.7,        // [engine] jump_keyboardgrace_max
    gravity: 750.0,            // [engine] sv_gravity
    jump_height: 80.0,         // [set] jumpheight
    double_jump_height: 80.0,  // [mp] superjump_min_height = superjump_max_height
    jump_grace_time: 0.2,      // [engine] jump_graceperiod

    // Wall-run
    wallrun_time_limit: 2.0,   // [live] player wall-run time limit (the wiki's 1.75 is wrong)
    wallrun_slip_time: 0.7,    // [engine] wallrun_sliptime
    wallrun_slip_speed: 70.0,  // [engine] wallrun_slipvel
    wallrun_slip_slowdown: 0.5, // [engine] wallrun_slipslowdown
    wallrun_up_boost: 250.0,   // [engine] wallrun_upWallBoost
    wallrun_gravity_ramp_time: 0.7, // [engine] wallrun_gravityRampUpTime
    wallrun_max_speed: 450.0,  // [mp] (client default 240, campaign 280) wallrun_maxSpeedHorizontal
    wallrun_max_speed_backward: 50.0, // [engine] wallrun_maxSpeedHorizontalBackward
    wallrun_accelerate: 1500.0, // [mp] (client default 7) wallrun_accelerateHorizontal
    wallrun_friction: 4.0,     // [engine] wallrun_friction
    wallrun_max_speed_vertical: 300.0, // [engine] wallrun_maxSpeedVertical
    wallrun_accelerate_vertical: 450.0, // [engine] wallrun_accelerateVertical
    wallrun_upward_push: 0.65, // [engine] wallrun_upwardAutoPush
    wallrun_fall_away_speed: 70.0, // [mp] wallrun_fallAwaySpeed
    wallrun_strength_loss_start: 1000.0, // [mp] (campaign 3): in MP the upward help never fades wallrun_strengthLossStart
    wallrun_strength_loss_end: 1000.0,   // [mp] (campaign 5) wallrun_strengthLossEnd
    wall_jump_up_speed: 320.0,      // [mp] (campaign 160) wallrun_jumpUpSpeed
    wall_jump_outward_speed: 250.0, // [mp] (campaign 200) wallrun_jumpOutwardSpeed
    wall_jump_input_speed: 100.0,   // [engine] wallrun_jumpInputDirSpeed

    // Wall-hang (aim down sights on a wall)
    wall_hang_time_limit: 9.0,  // [live] player wall-hang time limit (the wiki's 11 is wrong)
    wall_hang_stop_time: 0.5,   // [engine] wallrun_hangStopTime
    wall_hang_slip_time: 1.0,   // [engine] wallrun_hangsliptime

    // Mantle
    mantle_height: 80.0,        // [engine] automantle_height
    mantle_max_view_angle: 50.0, // [mp] automantle_maxangle_view
    mantle_max_view_angle_wallrun: 45.0, // [engine] automantle_wallrun_maxangle_view
    mantle_eye_below: -10.0,    // [engine] automantle_height_below
    mantle_eye_level: 10.0,     // [engine] automantle_height_level
    mantle_eye_above: 30.0,     // [engine] automantle_height_above
    mantle_time_below: 1.11,    // [engine] automantle_duration_below
    mantle_time_level: 1.0,     // [engine] automantle_duration_level
    mantle_time_above: 0.5,     // [engine] automantle_duration_above
    mantle_time_high: 0.35,     // [engine] automantle_duration_high

    // Terrain
    max_slope_deg: 45.0,        // [guess]
    step_height: 18.0,          // [set] stepheight
)
